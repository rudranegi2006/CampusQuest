# Replace this with a long random secret. Keep it private; give it only to the backend service.
INFERENCE_API_TOKEN=replace-with-a-long-random-secret

# The service listens on localhost only by default.
HOST_PORT=8000

# Starting knobs, not validated confidence values. Tune with independent held-out photos.
MIN_SIMILARITY=0.65
MIN_MARGIN=0.04
MAX_IMAGE_BYTES=8388608
AUTO_BUILD_GALLERY=true
